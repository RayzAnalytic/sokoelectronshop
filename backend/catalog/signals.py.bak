import logging

from django.db import transaction
from django.db.models import F
from django.db.models.signals import post_delete, pre_save
from django.dispatch import receiver

from checkout.models import Order, OrderItem

logger = logging.getLogger(__name__)


COUNTED_STATUSES = {
    Order.Status.DELIVERED,
}


def _adjust_product(product_id, delta, reference=""):
    from catalog.models import Product

    if not product_id or not delta:
        return
    try:
        Product.objects.filter(pk=product_id).update(
            sales_count=F("sales_count") + delta,
        )
    except Exception:
        logger.exception(
            "sales_count update failed for product %s (order %s)",
            product_id, reference,
        )


def _apply_delta(order, sign: int) -> None:
    for item in order.items.all():
        _adjust_product(
            item.product_id,
            sign * item.quantity,
            order.reference,
        )


def _counted_order(order_id):
    if not order_id:
        return None
    try:
        order = Order.objects.only("status", "reference").get(pk=order_id)
    except Order.DoesNotExist:
        return None
    if order.status not in COUNTED_STATUSES:
        return None
    return order


@receiver(pre_save, sender=Order, dispatch_uid="catalog.sync_sales_count")
def sync_sales_count_on_status_change(sender, instance, **kwargs):
    if instance.pk is None:
        return

    try:
        previous = Order.objects.only("status").get(pk=instance.pk)
    except Order.DoesNotExist:
        return

    old_status = previous.status
    new_status = instance.status

    if old_status == new_status:
        return

    was_counted = old_status in COUNTED_STATUSES
    now_counted = new_status in COUNTED_STATUSES

    if was_counted == now_counted:
        return

    sign = 1 if now_counted else -1

    transaction.on_commit(lambda: _apply_delta(instance, sign))


@receiver(post_delete, sender=Order, dispatch_uid="catalog.sync_sales_count_delete")
def sync_sales_count_on_delete(sender, instance, **kwargs):
    if instance.status not in COUNTED_STATUSES:
        return

    transaction.on_commit(lambda: _apply_delta(instance, -1))


@receiver(
    post_delete,
    sender=OrderItem,
    dispatch_uid="catalog.sync_sales_count_item_delete",
)
def sync_sales_count_on_item_delete(sender, instance, **kwargs):
    order = _counted_order(getattr(instance, "order_id", None))
    if order is None:
        return

    product_id = instance.product_id
    quantity = instance.quantity
    reference = order.reference

    transaction.on_commit(
        lambda: _adjust_product(product_id, -quantity, reference)
    )


@receiver(
    pre_save,
    sender=OrderItem,
    dispatch_uid="catalog.sync_sales_count_item_change",
)
def sync_sales_count_on_item_change(sender, instance, **kwargs):
    if instance.pk is None:
        return

    try:
        previous = OrderItem.objects.only("quantity", "product_id").get(
            pk=instance.pk,
        )
    except OrderItem.DoesNotExist:
        return

    if previous.product_id != instance.product_id:
        return

    delta = instance.quantity - previous.quantity
    if delta == 0:
        return

    order = _counted_order(getattr(instance, "order_id", None))
    if order is None:
        return

    product_id = instance.product_id
    reference = order.reference

    transaction.on_commit(
        lambda: _adjust_product(product_id, delta, reference)
    )from django.db.models.signals import post_save, post_delete
from django.dispatch import receiver
from catalog.models import Product
from dashboard.【entity-whatsapp¦canonical_name=WhatsApp】.models import WhatsAppCatalog, WhatsAppCatalogItem

@receiver(post_save, sender=Product)
def sync_product_to_whatsapp_catalog(sender, instance, created, **kwargs):
    """Auto-create/update WhatsAppCatalogItem when catalog Product is saved"""
    try:
        catalog = WhatsAppCatalog.get_solo()
        sku = (instance.sku or f"PROD_{instance.id}")[:100]
        
        # Truncate to avoid varchar(200) error
        name = instance.name[:180]
        
        defaults = {
            "store_product": instance,
            "sku": sku[:100],
            "name": name,
            "store_product_name": instance.name[:250],
            "store_product_slug": (instance.slug or "")[:200],
            "description": (getattr(instance, 'description', '') or instance.name)[:900],
            "product_status": "active",
            "sync_status": "pending",
            "product_url": f"/products/{instance.slug}" if instance.slug else "",
        }
        
        # Try get price
        try:
            if hasattr(instance, 'price') and instance.price:
                defaults["price"] = float(instance.price)
            elif hasattr(instance, 'base_price') and instance.base_price:
                defaults["price"] = float(instance.base_price)
        except:
            pass
        
        # Try image
        try:
            first_img = instance.images.first()
            if first_img and first_img.image:
                defaults["image_url"] = str(first_img.image.url)[:500]
        except:
            pass
        
        item, created_item = WhatsAppCatalogItem.objects.update_or_create(
            catalog=catalog,
            retailer_id=sku,
            defaults=defaults
        )
        
        if created_item:
            print(f"Auto-synced new product to WhatsApp: {name}")
        else:
            print(f"Auto-updated WhatsApp catalog item: {name}")
            
    except Exception as e:
        print(f"WhatsApp auto-sync failed: {e}")
        # Don't raise - don't block product save

@receiver(post_delete, sender=Product)
def remove_product_from_whatsapp_catalog(sender, instance, **kwargs):
    """Remove WhatsAppCatalogItem when catalog Product is deleted"""
    try:
        sku = (instance.sku or f"PROD_{instance.id}")[:100]
        WhatsAppCatalogItem.objects.filter(retailer_id=sku).delete()
        print(f"Removed from WhatsApp catalog: {sku}")
    except Exception as e:
        print(f"WhatsApp auto-remove failed: {e}")
